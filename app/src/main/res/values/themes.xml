<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all in-app theming (ui/theme/Theme.kt); this only paints the
         window before the first frame so launch doesn't flash the wrong colour. -->
    <style name="Theme.ChannelSnap" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
